{
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["src/sw.ts"],

	"compilerOptions": {
		"target": "esnext",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"@/*": ["./src/*"]
		},
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		//		"noUnusedLocals": true,
		//		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
